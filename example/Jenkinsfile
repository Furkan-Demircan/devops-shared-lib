// A projesinin repo'sundaki Jenkinsfile — tamamı bu kadar.
// Library'yi sürüme sabitleyin: lib'deki her değişiklik tüm projeleri anında etkilemesin.
@Library('devops-lib@v1') _

standardPipeline(
    owner         : 'ayse-github',        // GitHub kullanıcı adı (@mention için)
    buildCmd      : 'make build',
    testCmd       : 'make test',
    deployStageCmd: './deploy.sh stage',  // stage branch'ine merge edilince çalışır
    deployProdCmd : './deploy.sh prod',   // onaylı stage -> main PR'ı merge edilince çalışır
    // Opsiyonel: yalnızca ilgili deploy adımına bağlanan Jenkins credential'ları
    stageCredentials: [string(credentialsId: 'stage-deploy-token', variable: 'DEPLOY_TOKEN')],
    prodCredentials : [string(credentialsId: 'prod-deploy-token',  variable: 'DEPLOY_TOKEN')]
)
