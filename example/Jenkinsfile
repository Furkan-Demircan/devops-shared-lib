// A projesinin repo'sundaki Jenkinsfile — tamamı bu kadar.
@Library('devops-lib') _

standardPipeline(
    owner         : 'ayse-github',        // GitHub kullanıcı adı (@mention için)
    buildCmd      : 'make build',
    testCmd       : 'make test',
    deployStageCmd: './deploy.sh stage',  // main'e push'ta çalışır
    deployProdCmd : './deploy.sh prod',   // v* tag'i / Release oluşturulunca çalışır
    // Opsiyonel: yalnızca deploy adımlarına bağlanan Jenkins credential'ları
    credentials   : [string(credentialsId: 'deploy-token', variable: 'DEPLOY_TOKEN')]
)